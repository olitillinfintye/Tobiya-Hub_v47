{
  "name": "tobiya-hub",
  "version": "0.4.7",
  "description": "Tobiya Hub — Multi-Headset VR Management for Windows: ADB device manager, live casting grid, remote app/video launch, usage analytics",
  "main": "main.js",
  "author": "Tobiya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/olitillinfintye/Tobiya-Hub-.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tobiya.hub",
    "productName": "Tobiya Hub",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      { "from": "build/platform-tools", "to": "platform-tools" }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "olitillinfintye",
        "repo": "Tobiya-Hub-Releases"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tobiya Hub",
      "artifactName": "Tobiya-Hub-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tobiya-Hub-Portable-${version}.${ext}"
    }
  }
}
